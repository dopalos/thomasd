{
  "paths": {
    "/policy": {
      "get": {
        "tags": ["policy"],
        "summary": "Get node policy / chain information",
        "operationId": "getPolicy",
        "responses": {
          "200": {
            "description": "Policy / chain metadata",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PolicyResponse" },
                "examples": {
                  "dev": {
                    "value": {
                      "unit": "mas",
                      "fee_bps": 10,
                      "min_fee_mas": 1,
                      "max_msg_commit_len": 64,
                      "allowed_chain_id": "thomas-dev-1",
                      "expiry_rule": "valid if expiry_height==0 OR current_height < expiry_height",
                      "signing": {
                        "algo": "ed25519",
                        "pubkey_hex": "deadbeef...",
                        "header_canonical": ["round", "from_height", "to_height", "tx_count", "root", "time_utc"]
                      }
                    }
                  }
                }
              },
              "text/plain": {
                "schema": { "type": "string" },
                "examples": { "plain": { "value": "thomas-dev-1" } }
              }
            }
          }
        }
      }
    }
  }
}
