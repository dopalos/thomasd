{
  "paths": {
    "/policy": {
      "get": {
        "tags": ["policy"],
        "summary": "Get node policy / chain information",
        "operationId": "getPolicy",
        "responses": {
          "200": {
            "description": "Policy / chain metadata",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PolicyResponse" },
                "examples": {
                  "json": { "value": { "chain_id": "thomas-dev-1" } }
                }
              },
              "text/plain": {
                "schema": { "type": "string" },
                "examples": {
                  "plain": { "value": "chain_id=thomas-dev-1" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PolicyResponse": {
        "type": "object",
        "required": ["chain_id"],
        "properties": {
          "chain_id": { "type": "string", "description": "Current chain ID" }
        },
        "additionalProperties": true
      }
    }
  }
}
