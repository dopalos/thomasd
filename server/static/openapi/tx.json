{
  "paths": {
    "/tx": {
      "post": {
        "tags": ["tx"],
        "summary": "Submit a transfer",
        "operationId": "postTx",
        "parameters": [
          { "$ref": "#/components/parameters/DebugParam" },
          { "$ref": "#/components/parameters/DebuglogParam" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TxRequest" },
              "examples": {
                "ok": {
                  "value": {
                    "type": 1,
                    "from": "tho1alice",
                    "to": "tho1bob",
                    "amount_mas": 100000,
                    "fee_mas": 100,
                    "nonce": 4935,
                    "expiry_height": 0,
                    "chain_id": "thomas-dev-1",
                    "msg_commitment": "d20bece125baf11c1f7c0dfff8b20ca575941cb86f2fc521068b2653a75cd3c4"
                  }
                }
              }
            },
            "application/cbor": {
              "schema": { "$ref": "#/components/schemas/TxRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted into queue (applied may be true/false)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TxResponse" },
                "examples": {
                  "bad_nonce": {
                    "summary": "Parsed but not applied due to nonce",
                    "value": {
                      "status": "queued",
                      "parsed": true,
                      "ok": true,
                      "applied": false,
                      "reason": "apply:bad_nonce",
                      "tx_hash": "1372e21920...",
                      "from": "tho1alice",
                      "to": "tho1bob",
                      "amount_mas": 100000,
                      "fee_mas": 100,
                      "amount": 10000,
                      "fee": 10,
                      "nonce": 4935,
                      "current_nonce": 4940,
                      "expected_nonce": 4941,
                      "expected_fee_mas": 100,
                      "height": 18205,
                      "time_utc": 1756620556,
                      "merkle_root": "bf495ac885...909c2",
                      "receipts_count": 16843
                    }
                  },
                  "bad_chain_id": {
                    "summary": "Rejected by policy",
                    "value": {
                      "status": "queued",
                      "parsed": true,
                      "ok": false,
                      "applied": false,
                      "reason": "bad_chain_id"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
