{
  "paths": {
    "/round/latest/signed": {
      "get": {
        "summary": "Latest signed round header",
        "operationId": "getLatestSigned",
        "responses": {
          "200": {
            "description": "Signed header",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignedResponse" },
                "examples": {
                  "sample": {
                    "value": {
                      "algo": "ed25519",
                      "header": {
                        "round": 5,
                        "from_height": 18192,
                        "to_height": 18193,
                        "tx_count": 16837,
                        "root": "92b9792d4afeea7ab4e083f902e9c81549e205b2b0dccb80252fb7e3d4ea3b72",
                        "time_utc": 1756482123
                      },
                      "message_hex": "",
                      "message_b64": "VEhPTUFTfGhkcnx2MXx7InJvdW5kIjo1LCJmcm9tX2hlaWdodCI6MTgxOTIsInRvX2hlaWdodCI6MTgxOTMsInR4X2NvdW50IjoxNjgzNywicm9vdCI6IjkyYjk3OTJkNGFmZWVhN2FiNGUwODNmOTAyZTljODE1NDllMjA1YjJiMGRjY2I4MDI1MmZiN2UzZDRlYTNiNzIiLCJ0aW1lX3V0YyI6MTc1NjQ4MjEyM30=",
                      "pubkey_hex": "4f8a1eb9987deb8f01cbc6d49a2feeedcba9aad1dc6aded3881a8186573141db",
                      "scheme": "ed25519",
                      "signature_hex": "c50a8b9e8e39e9d2d49982f4bd3a3795b0a41cdf852ccd92e6bf8172ad01c9aa336c8f1345365487b2563e58a3957486d7f68ac6f70db6d17f537d2c5581c806",
                      "signature_valid": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/round/{round}/signed": {
      "get": {
        "summary": "Signed header for a specific round",
        "operationId": "getSignedByRound",
        "parameters": [
          { "name": "round", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": {
            "description": "Signed header",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignedResponse" }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Hex64": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$",
        "description": "32-byte hex string"
      },
      "Hex128": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{128}$",
        "description": "64-byte hex string"
      },
      "RoundHeader": {
        "type": "object",
        "required": ["round", "from_height", "to_height", "tx_count", "root", "time_utc"],
        "properties": {
          "round": { "type": "integer", "format": "int64" },
          "from_height": { "type": "integer", "format": "int64" },
          "to_height": { "type": "integer", "format": "int64" },
          "tx_count": { "type": "integer", "format": "int64" },
          "root": { "$ref": "#/components/schemas/Hex64" },
          "time_utc": { "type": "integer", "format": "int64", "description": "Unix epoch seconds (UTC)" }
        }
      },
      "SignedResponse": {
        "type": "object",
        "required": ["scheme", "pubkey_hex", "signature_hex", "header"],
        "properties": {
          "scheme": { "type": "string", "example": "ed25519" },
          "algo": { "type": "string", "example": "ed25519" },
          "pubkey_hex": { "$ref": "#/components/schemas/Hex64" },
          "signature_hex": { "$ref": "#/components/schemas/Hex128" },
          "signature_valid": { "type": "boolean" },
          "message_hex": { "type": "string" },
          "message_b64": { "type": "string", "format": "byte" },
          "header": { "$ref": "#/components/schemas/RoundHeader" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["ok", "applied", "error"],
        "properties": {
          "ok": { "type": "boolean" },
          "applied": { "type": "boolean" },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
