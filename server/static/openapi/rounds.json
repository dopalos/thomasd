{
  "paths": {
    "/round/latest/signed": {
      "get": {
        "tags": ["rounds"],
        "summary": "Get latest round with signature",
        "operationId": "getLatestSignedRound",
        "responses": {
          "200": {
            "description": "Signed latest round",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignedResponse" },
                "examples": {
                  "example": {
                    "value": {
                      "header": {
                        "round": 5,
                        "from_height": 18193,
                        "to_height": 18212,
                        "tx_count": 16846,
                        "root": "e0f26435ae89...29f8621",
                        "time_utc": 1756640561
                      },
                      "algo": "ed25519",
                      "pubkey_hex": "4f0c...abcd",
                      "signature_hex": "9a1b...ff00"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No round",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/round/{round}/signed": {
      "get": {
        "tags": ["rounds"],
        "summary": "Get round N with signature",
        "operationId": "getSignedRound",
        "parameters": [
          {
            "name": "round",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Signed round",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SignedResponse" } } }
          },
          "400": { "description": "Bad round id", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RoundHeader": {
        "type": "object",
        "required": ["round", "from_height", "to_height", "tx_count", "root", "time_utc"],
        "properties": {
          "round": { "type": "integer" },
          "from_height": { "type": "integer" },
          "to_height": { "type": "integer" },
          "tx_count": { "type": "integer" },
          "root": { "type": "string", "description": "Merkle root (hex)" },
          "time_utc": { "type": "integer", "description": "Unix seconds (UTC)" }
        },
        "additionalProperties": true
      },
      "SignedResponse": {
        "type": "object",
        "required": ["header", "pubkey_hex"],
        "properties": {
          "header": { "$ref": "#/components/schemas/RoundHeader" },
          "algo": { "type": "string", "description": "Signing scheme, e.g. 'ed25519'" },
          "scheme": { "type": "string", "description": "(compat) may be present instead of 'algo'" },
          "pubkey_hex": { "type": "string", "description": "hex-encoded public key" },
          "signature_hex": { "type": "string", "description": "hex-encoded signature" }
        },
        "additionalProperties": true
      },
      "ErrorResponse": {
        "type": "object",
        "properties": { "error": { "type": "string" } },
        "additionalProperties": true
      }
    }
  }
}
