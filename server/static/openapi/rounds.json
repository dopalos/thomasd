{
  "paths": {
    "/round/latest/signed": {
      "get": {
        "tags": ["rounds"],
        "summary": "Get the latest round with signature",
        "operationId": "getLatestSigned",
        "responses": {
          "200": {
            "description": "Latest signed round",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignedResponse" },
                "examples": {
                  "ed25519": {
                    "value": {
                      "header": {
                        "round": 5,
                        "from_height": 18190,
                        "to_height": 18193,
                        "tx_count": 16837,
                        "root": "2f1f018e...4bb9",
                        "time_utc": 1756482123
                      },
                      "algo": "ed25519",
                      "pubkey_hex": "deadbeef...",
                      "signature_hex": "abcd..."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No round yet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/round/{round}/signed": {
      "get": {
        "tags": ["rounds"],
        "summary": "Get a specific round with signature",
        "operationId": "getRoundSigned",
        "parameters": [
          { "$ref": "#/components/parameters/RoundParam" }
        ],
        "responses": {
          "200": {
            "description": "Signed round",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignedResponse" }
              }
            }
          },
          "400": {
            "description": "Bad round number",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Round not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  }
}
