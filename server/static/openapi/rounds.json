{
  "paths": {
    "/round/latest/signed": {
      "get": {
        "tags": ["rounds"],
        "summary": "Get latest round header with signature",
        "operationId": "getLatestSignedRound",
        "responses": {
          "200": {
            "description": "Signed header of latest round",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignedResponse" },
                "examples": {
                  "latest": {
                    "value": {
                      "round": 5,
                      "header": {
                        "height": 18210,
                        "time_utc": 1756639145,
                        "tx_count": 16844,
                        "merkle_root": "4fce119871b9b489cfb0a6a18aa30e1b8e5ec4c11e8288890c0a6bcf6ae7328e"
                      },
                      "signature": "BASE64_SIGNATURE",
                      "scheme": "ed25519"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/round/{round}/signed": {
      "get": {
        "tags": ["rounds"],
        "summary": "Get specific round header with signature",
        "operationId": "getSignedRound",
        "parameters": [
          {
            "name": "round",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 0 },
            "description": "Round number"
          }
        ],
        "responses": {
          "200": {
            "description": "Signed header of the requested round",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignedResponse" }
              }
            }
          },
          "404": {
            "description": "Round not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "not_found": {
                    "value": { "code": "round_not_found", "message": "round 123 not found" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RoundHeader": {
        "type": "object",
        "required": ["height", "time_utc", "tx_count", "merkle_root"],
        "properties": {
          "height": { "type": "integer", "format": "int64" },
          "time_utc": { "type": "integer", "format": "int64", "description": "UNIX seconds" },
          "tx_count": { "type": "integer", "format": "int64" },
          "merkle_root": { "type": "string" }
        },
        "additionalProperties": true
      },
      "SignedResponse": {
        "type": "object",
        "required": ["round", "header", "signature"],
        "properties": {
          "round": { "type": "integer", "format": "int64" },
          "header": { "$ref": "#/components/schemas/RoundHeader" },
          "signature": { "type": "string", "description": "Signature over header" },
          "signer": { "type": "string", "description": "Signer identity (optional)" },
          "scheme": {
            "type": "string",
            "description": "Signature scheme. Compat layer injects 'ed25519' when empty.",
            "default": "ed25519"
          }
        },
        "additionalProperties": true
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "meta": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    }
  }
}
