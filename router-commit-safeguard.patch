+// ------------------------------------------------------------
+// CommitRound panic-safe wrapper
+// ------------------------------------------------------------
+// commitRoundSafe calls Engine.CommitRound with panic protection so that
+// the HTTP server returns a JSON error instead of closing the connection.
+func commitRoundSafe(eng *app.Engine) (hdr any, ok bool, err error) {
+    defer func() {
+        if r := recover(); r != nil {
+            err = fmt.Errorf("engine.CommitRound panic: %v", r)
+        }
+    }()
+    h, k := eng.CommitRound()
+    return h, k, nil
+}
